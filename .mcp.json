{
  "mcpServers": {
    "whisper-local": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR}/.claude/bin/whisper-mcp.js"
      ]
    },
    "pg-vector": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PROJECT_DIR}/.claude/bin/pg-mcp.sh",
        "vector"
      ]
    },
    "pg-artefacts": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PROJECT_DIR}/.claude/bin/pg-mcp.sh",
        "artefacts"
      ]
    },
    "pg-library": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PROJECT_DIR}/.claude/bin/pg-mcp.sh",
        "library"
      ]
    },
    "lsp-go": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/gopls",
      "args": ["mcp"]
    },
    "lsp-ts": {
      "type": "stdio",
      "command": "/Users/rick/go/bin/mcp-language-server",
      "args": [
        "-workspace", "${CLAUDE_PROJECT_DIR}",
        "-lsp", "typescript-language-server",
        "--",
        "--stdio"
      ]
    }
  }
}
