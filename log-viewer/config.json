{
  "port": 4002,
  "refreshIntervalMs": 1000,
  "maxLinesInMemory": 50000,
  "tailInitialLines": 500,
  "databases": {
    "vector": {
      "label": "vector_artefacts",
      "envFile": "../backend/.env.dev",
      "urlKey": "VECTOR_ARTEFACTS_DB_URL",
      "statementTimeoutMs": 8000,
      "maxPoolConnections": 4
    },
    "dev": {
      "label": "mmff_dev",
      "envFile": "../backend/.env.dev",
      "urlKey": "MMFF_DEV_DB_URL",
      "statementTimeoutMs": 8000,
      "maxPoolConnections": 2
    },
    "library": {
      "label": "mmff_library",
      "envFile": "../backend/.env.dev",
      "parts": {
        "host": "LIBRARY_DB_HOST",
        "port": "LIBRARY_DB_PORT",
        "user": "LIBRARY_DB_USER",
        "password": "LIBRARY_DB_PASSWORD",
        "database": "LIBRARY_DB_NAME"
      },
      "statementTimeoutMs": 8000,
      "maxPoolConnections": 2
    }
  },
  "defaultSource": "audit_logs",
  "sources": [
    {
      "id": "audit_logs",
      "name": "Audit Logs",
      "group": "Security",
      "description": "Auth, permission, admin, and product audit events.",
      "color": "#10B981",
      "db": "vector",
      "table": "audit_logs",
      "idColumn": "audit_logs_id",
      "tsColumn": "audit_logs_created_at",
      "orderColumn": "audit_logs_created_at",
      "columns": [
        "audit_logs_id",
        "audit_logs_created_at",
        "audit_logs_action",
        "audit_logs_resource",
        "audit_logs_resource_id",
        "audit_logs_id_user",
        "audit_logs_id_subscription",
        "audit_logs_ip_address",
        "audit_logs_source_transport",
        "audit_logs_metadata"
      ],
      "searchColumns": [
        "audit_logs_action",
        "audit_logs_resource",
        "audit_logs_resource_id",
        "audit_logs_id_user",
        "audit_logs_id_subscription",
        "audit_logs_ip_address",
        "audit_logs_source_transport",
        "audit_logs_metadata"
      ],
      "messageTemplate": "{audit_logs_action}  {audit_logs_resource}{resource_id_suffix}  ip={audit_logs_ip_address}  via={audit_logs_source_transport}  user={audit_logs_id_user}",
      "levelFrom": "audit_logs_action",
      "levelRules": [
        { "match": "(failed|violation|reuse|denied|revoke|deactivated|lockout)", "level": "ERROR" },
        { "match": "(grace|challenge|mfa|trusted_device|expired|archived)", "level": "WARN" },
        { "match": "(login|created|granted|workspace_switched)", "level": "SUCCESS" },
        { "match": "token_refresh$", "level": "DEBUG" }
      ],
      "defaultLevel": "INFO",
      "facets": [
        { "field": "audit_logs_action", "label": "Action" },
        { "field": "audit_logs_resource", "label": "Resource" },
        { "field": "audit_logs_source_transport", "label": "Transport" },
        { "field": "audit_logs_ip_address", "label": "IP" },
        { "field": "audit_logs_id_user", "label": "User" }
      ],
      "correlationKeys": {
        "user": "audit_logs_id_user",
        "subscription": "audit_logs_id_subscription",
        "resource": "audit_logs_resource_id",
        "ip": "audit_logs_ip_address"
      }
    },
    {
      "id": "users_sessions",
      "name": "User Sessions",
      "group": "Security",
      "description": "Session lifecycle, DPoP key thumbprints, revocation, and rotation.",
      "color": "#3B82F6",
      "db": "vector",
      "table": "users_sessions",
