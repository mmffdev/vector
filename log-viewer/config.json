        "users_sessions_ip_address",
        "users_sessions_user_agent",
        "users_sessions_revoked",
        "users_sessions_rotated_at",
        "users_sessions_dpop_jkt",
        "users_sessions_first_country",
        "users_sessions_first_asn"
      ],
      "searchColumns": [
        "users_sessions_id_user",
        "users_sessions_ip_address",
        "users_sessions_user_agent",
        "users_sessions_dpop_jkt",
        "users_sessions_first_country",
        "users_sessions_first_asn"
      ],
      "messageTemplate": "session  user={users_sessions_id_user}  ip={users_sessions_ip_address}  country={users_sessions_first_country}  asn={users_sessions_first_asn}  jkt={users_sessions_dpop_jkt}",
      "levelFrom": "_derived",
      "levelRules": [
        { "match": "revoked", "level": "ERROR" },
        { "match": "rotated", "level": "WARN" },
        { "match": "active", "level": "SUCCESS" }
      ],
      "defaultLevel": "INFO",
      "facets": [
        { "field": "users_sessions_revoked", "label": "Revoked" },
        { "field": "users_sessions_first_country", "label": "Country" },
        { "field": "users_sessions_first_asn", "label": "ASN" },
        { "field": "users_sessions_ip_address", "label": "IP" },
        { "field": "users_sessions_id_user", "label": "User" }
      ],
      "correlationKeys": {
        "user": "users_sessions_id_user",
        "ip": "users_sessions_ip_address",
        "dpop": "users_sessions_dpop_jkt"
      }
    },
