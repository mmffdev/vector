{
  "name": "mmff-pm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo -p 5101",
    "build": "next build",
    "start": "next start -p 5101",
    "lint": "npm run typecheck && npm run lint:project",
    "typecheck": "tsc --noEmit",
    "lint:project": "npm run lint:addressables && npm run lint:role-literals && npm run lint:writer-boundary && npm run lint:dev-css && npm run lint:no-raw-table && npm run lint:secondary-nav && npm run lint:tab-deep-link && npm run lint:portfolio-library-read && npm run lint:scope-literals && npm run lint:public-helper-allowlist && npm run lint:no-db-in-handlers && npm run lint:public-dto-mapper && npm run lint:page-description && npm run lint:h2-panel-only",
    "lint:addressables": "python3 dev/scripts/lint_addressables.py",
    "lint:role-literals": "python3 dev/scripts/lint_role_literals.py",
    "lint:writer-boundary": "python3 dev/scripts/lint_writer_boundary.py",
    "lint:dev-css": "python3 dev/scripts/lint_dev_css.py",
    "lint:secondary-nav": "python3 dev/scripts/lint_secondary_nav.py",
    "lint:no-raw-table": "python3 dev/scripts/lint_no_raw_table.py",
    "lint:tab-deep-link": "python3 dev/scripts/lint_tab_deep_link.py",
    "lint:portfolio-library-read": "python3 dev/scripts/lint_portfolio_library_read.py",
    "lint:scope-literals": "python3 dev/scripts/lint_scope_literals.py",
    "lint:public-helper-allowlist": "python3 dev/scripts/lint_public_helper_allowlist.py",
    "lint:no-db-in-handlers": "python3 dev/scripts/lint_no_db_in_handlers.py",
    "lint:public-dto-mapper": "python3 dev/scripts/lint_public_dto_mapper.py",
    "lint:page-description": "python3 dev/scripts/lint_page_description.py",
    "lint:h2-panel-only": "python3 dev/scripts/lint_h2_panel_only.py",
    "lint:sql-in-sqlfile-only": "python3 dev/scripts/lint_sql_in_sqlfile_only.py",
    "lint:no-empty-route-block": "python3 dev/scripts/lint_no_empty_route_block.py",
    "lint:exemption-ratchet": "python3 dev/scripts/lint_exemption_ratchet.py",
    "lint:deferral-needs-td-id": "python3 dev/scripts/lint_deferral_needs_td_id.py",
    "lint:package-naming-convention": "python3 dev/scripts/lint_package_naming_convention.py",
    "lint:column-prefix-convention": "python3 dev/scripts/lint_column_prefix_convention.py",
    "lint:custom-field-prefix": "python3 dev/scripts/lint_custom_field_prefix.py",
    "lint:cross-db-writer-test": "python3 dev/scripts/lint_cross_db_writer_test.py",
    "lint:api-caller-discipline": "python3 dev/scripts/lint_api_caller_discipline.py",
    "lint:api-helper-exclusive": "python3 dev/scripts/lint_api_helper_exclusive.py",
    "lint:no-direct-workspace-id": "python3 dev/scripts/lint_no_direct_workspace_id.py",
    "lint:no-old-context-imports": "python3 dev/scripts/lint_no_old_context_imports.py",
    "lint:no-ghost-scope-ls-reads": "python3 dev/scripts/lint_no_ghost_scope_ls_reads.py",
    "lint:no-singular-workspace-table": "python3 dev/scripts/lint_no_singular_workspace_table.py",
    "lint:no-v1-broker-imports": "bash dev/scripts/lint_no_v1_broker_imports.sh",
    "lint:route-orphans": "python3 dev/scripts/lint_route_orphans.py",
    "lint:route-orphans:strict": "python3 dev/scripts/lint_route_orphans.py --strict",
    "lint:rf1": "npm run lint:sql-in-sqlfile-only && npm run lint:no-empty-route-block && npm run lint:exemption-ratchet && npm run lint:package-naming-convention && npm run lint:cross-db-writer-test && npm run lint:column-prefix-convention && npm run lint:custom-field-prefix && npm run lint:no-direct-workspace-id && npm run lint:no-old-context-imports && npm run lint:no-ghost-scope-ls-reads",
    "api:snap": "bash dev/scripts/snap_api.sh",
    "api:sync": "python3 dev/scripts/extract_routes.py && python3 dev/scripts/extract_handler_shapes.py && python3 dev/scripts/sync_specs.py",
    "api:test:parser": "python3 dev/scripts/extract_routes_test.py",
    "api:check": "bash dev/scripts/check_routes.sh --all && python3 dev/scripts/check_callers.py --all",
    "api:check:v1": "bash dev/scripts/check_routes.sh --spec siteAPI.yaml && python3 dev/scripts/check_callers.py --spec siteAPI.yaml",
    "api:check:v2": "bash dev/scripts/check_routes.sh --spec samanthaAPI.yaml && python3 dev/scripts/check_callers.py --spec samanthaAPI.yaml",
    "api:install-hooks": "cp dev/scripts/pre-push.sh .git/hooks/pre-push && chmod +x .git/hooks/pre-push && echo 'pre-push hook installed'",
    "audit:dashboard": "python3 dev/scripts/audit_dashboard.py",
    "audit:field-library": "PGPASSWORD=$(grep '^DB_PASSWORD=' backend/.env.local | cut -d= -f2-) /opt/homebrew/opt/libpq/bin/psql -h localhost -p 5435 -U mmff_dev -d vector_artefacts -f dev/scripts/audit_field_library_orphans.sql",
    "e2e": "node --test --test-reporter=spec 'e2e/**/*.spec.mjs'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sentinel": "npm run test:sentinel:unit && npm run test:sentinel:page && npm run test:sentinel:e2e",
    "test:sentinel:unit": "vitest run --testNamePattern \"^sentinel\\.unit\"",
    "test:sentinel:page": "vitest run --testNamePattern \"^sentinel\\.page\"",
    "test:sentinel:e2e": "playwright test --config dev/tests/playwright/playwright.sentinel.config.ts",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-table-cell": "^3.0.0",
    "@tiptap/extension-table-header": "^3.0.0",
    "@tiptap/extension-table-row": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/extensions": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.10.2",
    "3d-force-graph": "^1.80.0",
    "cytoscape": "^3.33.4",
    "cytoscape-dagre": "^2.5.0",
    "d3-dag": "^1.2.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12.38.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^3.13.0",
    "lucide-react": "^1.14.0",
    "next": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "sonner": "^2.0.7",
    "three": "^0.184.0",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cytoscape": "^3.21.9",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/selenium-webdriver": "^4.1.28",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jscpd": "^4.2.4",
    "jsdom": "^25.0.1",
    "knip": "^6.15.0",
    "marked": "^18.0.2",
    "selenium-webdriver": "^4.27.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
